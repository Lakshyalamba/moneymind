# ------------------------------------------------------------------------------
# 1. API SERVER LOCATION (Optional)
# ------------------------------------------------------------------------------
# The fully qualified URL of the MoneyMind backend server.
# If omitted, defaults to 'http://localhost:3333' (the local dev server location).
# Example for local development:
VITE_API_URL="http://localhost:3333"
