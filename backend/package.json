{
  "name": "moneymind-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "prisma db push --skip-generate --accept-data-loss && prisma generate",
    "start": "prisma db push --skip-generate --accept-data-loss && node prisma/seed.js && node src/bootstrap.js",
    "dev": "nodemon --watch src --watch prisma src/bootstrap.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-generate",
    "postinstall": "prisma generate",
    "test": "node run-tests.js",
    "test:coverage": "node --experimental-test-coverage run-tests.js",
    "lint": "eslint src",
    "validate:merchant-rules": "node scripts/validate-merchant-rules.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.57.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
