# ==============================================================================
# MoneyMind Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate it with your local development variables.
# NEVER commit raw secrets or production passwords directly to the repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE VARIABLES (Required)
# ------------------------------------------------------------------------------
# The connection string for your PostgreSQL database instance.
# Prisma uses this URL to connect to the database.
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?sslmode=[mode]
# Local Dev Default:
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/moneymind?sslmode=disable"

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# The port number on which the Node/Express backend server will listen.
PORT=3333

# The root URL of the backend server. Used for generating callback URLs.
BACKEND_URL="http://localhost:3333"

# Allowed cross-origin (CORS) frontend domains. Comma-separated if multiple.
FRONTEND_URL="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# A secure, random string used to sign JWT cookies (access/refresh tokens).
# Generate a secure secret in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate-a-secure-random-32-byte-hex-string-for-local-dev"

# ------------------------------------------------------------------------------
# 4. AI INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Your Gemini API Key from Google AI Studio. 
# If empty/missing, the backend advisor automatically serves clean, rule-based fallback advice.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH SIGN-IN (Optional)
# ------------------------------------------------------------------------------
# Credentials acquired from the Google Cloud Console (Credentials API page).
# If empty/missing, Google Sign-In button remains disabled, and only credentials auth is available.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
