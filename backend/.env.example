# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/moneymind?sslmode=disable"

# Secret key for signing JWT tokens
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Port number for backend server
PORT=3333

# Allowed CORS origins (comma-separated)
FRONTEND_URL="http://localhost:3000,http://localhost:5173"

# Google OAuth credentials (optional, disabled if blank)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public backend address
BACKEND_URL="http://localhost:3333"

# Google Gemini AI API key (optional, falls back to local rules if blank)
GEMINI_API_KEY=""
